# Copia in .env solo per riferimento: Django legge le variabili d'ambiente, non il file.
# In locale basta:  DJANGO_DEBUG=1 python manage.py runserver

DJANGO_DEBUG=0
DJANGO_SECRET_KEY=genera-una-chiave-lunga-e-casuale
# Domini aggiuntivi oltre a quello *.up.railway.app (che viene aggiunto da solo)
DJANGO_ALLOWED_HOSTS=prenotazioni.esempio.it
DJANGO_CSRF_TRUSTED_ORIGINS=https://prenotazioni.esempio.it
# Su Railway arriva in automatico collegando il servizio Postgres
DATABASE_URL=postgres://utente:password@host:5432/nome

# Stripe — chiavi di TEST per lo sviluppo, di LIVE in produzione
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
